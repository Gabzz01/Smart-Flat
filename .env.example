# Google Smart Device Management (https://developers.google.com/nest/device-access)
SDM_PROJECT_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Run without credentials against a saved SDM payload
# SDM_FIXTURE=fixtures/devices.json

# How often to re-read device state from Google (ms). Google rate-limits ListDevices per user and
# answers 429 RESOURCE_EXHAUSTED when polled too fast; the bridge logs it and retries on the next
# tick, but do not go far below the default.
POLL_INTERVAL_MS=60000

# Dyson purifying fan, over local MQTT. Optional: leave DYSON_SERIAL empty to run Nest-only.
# The password is the device's local MQTT password (base64 of a SHA-512 digest), not your Dyson
# account password. It is a secret: keep it in .env only.
DYSON_SERIAL=
DYSON_PASSWORD=
# Defaults to <serial>.local, which mDNS resolves. Set an IP when the host has no mDNS resolver
# (most Linux boxes without avahi/nss-mdns), or when a VPN route hides the LAN.
# DYSON_HOST=192.168.1.20
# Topic root, and it must be exact: the fan's broker refuses wildcards and any other topic, so a
# wrong value fails at subscribe. 438/438E/438K is a Purifier Cool, 527/527E/527K a Hot+Cool. Note
# the mDNS instance name is not a reliable source (this fan advertises 438 but answers on 438K).
# DYSON_PRODUCT_TYPE=438K
# DYSON_NAME=Dyson Purifier
# How often to ask the fan for sensor readings (ms). State changes arrive unprompted.
# DYSON_POLL_INTERVAL_MS=30000

# Run without a fan against a saved payload
# DYSON_FIXTURE=fixtures/dyson-state.json

# Octopus Energy (https://octopus.energy/dashboard/new/accounts/personal-details/api-access).
# Optional: leave OCTOPUS_API_KEY empty to run without energy endpoints. The key is read-only but
# exposes your consumption and account balance, so keep it in .env only.
OCTOPUS_API_KEY=
OCTOPUS_ACCOUNT_NUMBER=
# How often to re-read meter data (ms). Readings land a few times a day and Agile's next-day rates
# around 16:00, so polling faster only burns quota.
# OCTOPUS_POLL_INTERVAL_MS=1800000
# Gas meters report m3 (SMETS2) or kWh (SMETS1) and the API does not say which.
# `bun run check-octopus` prints the reading both ways so you can match it against your bill.
# OCTOPUS_GAS_UNITS=m3
# Calorific value in MJ/m3 used to convert gas volume to kWh. Varies by region and by day; the
# figure your bill was calculated with is printed on it.
# OCTOPUS_GAS_CALORIFIC_VALUE=39.5

# Run without a key against a saved payload
# OCTOPUS_FIXTURE=fixtures/octopus.json

# SimpliSafe. Optional: with no token the bridge runs without the alarm endpoints. Entry sensors
# become contact sensors, motion sensors and cameras become occupancy sensors.
#
# There is no username/password API. Sign in once in a browser with `bun run simplisafe-auth`; it
# writes the refresh token to .matter-storage/simplisafe-token.json. SimpliSafe issues a NEW refresh
# token on every refresh and the client rewrites that file each time, so the file is the source of
# truth. The value below is only a seed used when the file is missing — after the first refresh it
# is stale, which is harmless.
# SIMPLISAFE_REFRESH_TOKEN=
# Where the rotating token is kept. Defaults to <MATTER_STORAGE_PATH>/simplisafe-token.json, so it
# travels with the fabric state. It is a live credential: treat it like .env.
# SIMPLISAFE_TOKEN_PATH=

# How often to re-read entry-sensor state (ms). Nothing pushes a door: opening one while the system
# is disarmed produces no websocket event at all, so this poll is the only thing that ever moves a
# contact sensor, and at a minute a door opened and shut between ticks is simply never seen.
# SimpliSafe's cached view also trails the real door by 5-10s, so a door open for only a second or
# two may never appear no matter how fast this is; forcing a fresh read is not an option, as the
# base station takes longer than the 20s request timeout to answer one.
# SIMPLISAFE_POLL_INTERVAL_MS=10000
# How long an occupancy endpoint stays occupied after motion (ms). SimpliSafe reports the start of
# motion and never its end, so this is a hold, not a measurement. Too short and a controller misses
# the change; too long and a corridor reads as permanently busy. Tune it to the room.
# SIMPLISAFE_MOTION_HOLD_MS=60000

# Camera video is served over plain HTTP, because Matter cannot carry it: the camera device type
# needs the bridge to be a WebRTC peer and has no URL attribute at all. This proxies SimpliSafe's
# FLV stream with the bearer token attached, so http://<host>:<port>/ lists URLs that VLC, ffmpeg or
# a Home Assistant `generic` camera can open. Live view works without a camera subscription.
# SIMPLISAFE_STREAM_PORT=5541
# SECURITY: there is no authentication — anyone who reaches this port can watch the cameras. It
# binds to loopback for that reason. Set 0.0.0.0 only on a network you trust, and prefer an SSH
# tunnel or an authenticating reverse proxy.
# SIMPLISAFE_STREAM_HOST=127.0.0.1

# Run without an account against a saved payload
# SIMPLISAFE_FIXTURE=fixtures/simplisafe.json

# Somfy RTS shutters, over a CC1101 on the Pi's SPI bus (somfy-tx.py). Optional: leave empty to
# run without them. Format is `<name>:<address>`, comma separated:
# SOMFY_SHUTTERS=Living Room:0x123457,Bedroom:0x123458
#
# The address is the virtual remote id the shutter was paired to, not anything the hardware
# reports: pick any 3 bytes, one per shutter, then teach it with
# `bun run check-somfy "<name>" prog` while the shutter is in programming mode. Nothing discovers
# these and nothing verifies them, so a wrong value drives the wrong shutter or nothing at all.
#
# RTS is one-way. The shutter never answers, and the wall remote moves it without the bridge
# hearing, so controllers get open/close/stop and no position.
# SOMFY_SHUTTERS=

# Rolling code counters, one file per remote id. A shutter ignores a frame whose code is behind
# the last it accepted, so losing these means re-pairing. Defaults to /home/raspberry (the path
# baked into somfy-tx.py); point it at the Matter storage to keep all bridge state together.
# SOMFY_ROLL_DIR=/var/lib/matter-bridge
# GDO0, the CC1101 TX data pin (the jumper), in BCM numbering.
# SOMFY_GDO0=25
# How many times each frame repeats. More gets through a noisy 433 MHz band; each costs ~40ms.
# SOMFY_REPEATS=2
# Give up on a transmission after this long. pigpiod being down is the usual cause.
# SOMFY_TIMEOUT_MS=15000
# Log commands instead of transmitting, so the bridge runs on a machine with no radio.
# SOMFY_DRY_RUN=1

# Matter commissioning
MATTER_PORT=5540
MATTER_PASSCODE=20202021
MATTER_DISCRIMINATOR=3840
MATTER_SERIAL=bridge-0001

# Where node identity and fabric credentials are stored. Use an absolute path when the process
# does not start in the project directory. Copy this directory to move the bridge to another host.
# MATTER_STORAGE_PATH=/var/lib/matter-bridge

# matter.js log level: debug, info, notice, warn, error, fatal
# MATTER_LOG_LEVEL=debug
